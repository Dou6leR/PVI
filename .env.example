# Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=7119
POSTGRES_DB=CMS

# Exposed Host Ports
POSTGRES_HOST_PORT=5433
MONGO_HOST_PORT=27018
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@cms.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_HOST_PORT=5050

# n8n Workflow Automation
N8N_HOST_PORT=5678

# Ollama Local LLM Configuration
OLLAMA_HOST_PORT=11434

# AI Configuration ("auto" -> Gemini if API_KEY set, else Ollama; or force "ollama" / "gemini")
APP_CONFIG__AI__PROVIDER=auto
APP_CONFIG__AI__OLLAMA_URL=http://ollama:11434
APP_CONFIG__AI__OLLAMA_MODEL=qwen3.5:4b
APP_CONFIG__AI__OLLAMA_EMBEDDING_MODEL=bge-m3

# Google Gemini (set API_KEY to switch from Ollama to Gemini)
APP_CONFIG__AI__API_KEY=
APP_CONFIG__AI__MODEL=gemini-3.8-flash
